Edit Email:


DELIMITER //
CREATE DEFINER=`root`@`localhost` PROCEDURE `AlterEmail`(
    IN NewEmail VARCHAR(50),
    IN SearchFirstName VARCHAR(50),
    IN SearchLastName VARCHAR(50),
    IN SearchUserID VARCHAR(50)
)
BEGIN
	UPDATE Contacts 
    SET Email = NewEmail
    WHERE FirstName = SearchFirstName AND LastName = SearchLastName AND UserID = SearchUserID;
END //
DELIMITER ;




