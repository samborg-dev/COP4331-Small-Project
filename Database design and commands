Add contact:
This ones pretty self explanatory it just adds a contact into the contacts table. I added the User Attribution column to keep track of which user each contact belongs too.

CREATE DEFINER=`root`@`localhost` PROCEDURE `addContact`(
	IN NewFirstName varchar(50),
 	IN NewLastName varchar(50),
 	IN NewEmail varchar(50),
 	IN NewPhone varchar(50),
 	IN NewDateCreated date,
	IN NewUserAttribution varchar(50) 
)
BEGIN
	INSERT INTO Contacts (FirstName,LastName,Email,Phone,DateCreated,UserAttribution)
	VALUES (NewFirstName,NewLastName,NewEmail,NewPhone,NewDateCreated,NewUserAttribution);
END

