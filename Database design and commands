Contact Search:
DELIMITER //
CREATE DEFINER=`root`@`localhost` PROCEDURE `ContactSearch`(
	IN SearchUserID VARCHAR(50),
    IN SearchName VARCHAR(50)
)
BEGIN
SELECT * FROM Contacts WHERE UserID = SearchUserID AND CONCAT(FirstName,LastName)  like concat('%',SearchName,'%');
END //
DELIMITER ;



Delete Contact:


DELIMITER //
CREATE DEFINER=`root`@`localhost` PROCEDURE `DeleteContact`(
	IN DelFirstName VARCHAR(50),
    IN DelLastName VARCHAR(50),
    IN DelUserID VARCHAR(50)

)
BEGIN
DELETE FROM Contacts WHERE UserID = DelUserID and FirstName = DelFirstName AND LastName = DelLastName;

END //
DELIMITER ;



