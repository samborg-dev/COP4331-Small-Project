key: "Key" {
  grid-columns: 2
  grid-gap: 6
  style.fill: transparent
  k1: "Red outline = critical path" {
    width: 260
    height: 26
    style.fill: "#f8fafc"
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.font-size: 11
  }
  k2: "Two columns per phase" {
    width: 260
    height: 26
    style.fill: "#f1f5f9"
    style.stroke: "#e2e8f0"
    style.font-size: 11
  }
  k3: "M1 — HTTPS domain live" {
    width: 260
    height: 26
    style.fill: "#fef3c7"
    style.stroke: "#d97706"
    style.stroke-width: 2
    style.font-size: 11
  }
  k4: "M2 — All endpoints pass in Postman" {
    width: 260
    height: 26
    style.fill: "#fef3c7"
    style.stroke: "#d97706"
    style.stroke-width: 2
    style.font-size: 11
  }
  k5: "M3 — Full flow works on live site" {
    width: 260
    height: 26
    style.fill: "#fef3c7"
    style.stroke: "#d97706"
    style.stroke-width: 2
    style.font-size: 11
  }
  k6: "M4 — Slides submitted by all 5" {
    width: 260
    height: 26
    style.fill: "#fef3c7"
    style.stroke: "#d97706"
    style.stroke-width: 2
    style.font-size: 11
  }
}
